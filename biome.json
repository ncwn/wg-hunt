{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/drizzle",
      "!**/fixtures",
      "!packages/eval/synthetic/**/*.html",
      "!**/node_modules",
      "!.data",
      "!docs/design-system",
      "!apps/dashboard/src/api/schema.d.ts",
      "!apps/cli/src/api/schema.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
